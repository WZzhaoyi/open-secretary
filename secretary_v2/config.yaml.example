# Secretary v2 configuration template
# Copy this file to config.yaml and fill in real values.
# config.yaml is ignored by git and should not be committed.
#   cp config.yaml.example config.yaml

# LLM configuration
llm:
  provider: anthropic           # anthropic | openai | deepseek | gemini
  model: claude-sonnet-4-20250514
  api_key: YOUR_LLM_API_KEY
  base_url: ""                  # Optional custom/proxy endpoint
  max_tokens: 4096
  # Shared by the main agent and the internal fallback subagent.
  # For DeepSeek V4 thinking mode use model deepseek-v4-pro/deepseek-v4-flash.
  # OpenAI format: provider deepseek, or provider openai + base_url https://api.deepseek.com.
  # Anthropic format: provider anthropic + base_url https://api.deepseek.com/anthropic.
  # thinking enabled|disabled; effort high|max.
  effort: ""                    # OpenAI/DeepSeek reasoning effort, or Anthropic thinking effort
  thinking: ""                  # DeepSeek V4: enabled | disabled; empty uses provider default
  extra_body: {}

# Agent response language: auto | zh | en
language: auto

# User-facing command/status UI language: auto | zh | en
# auto uses Telegram user.language_code when available, then language, then en.
ui_language: auto

# Channel configuration
channels:
  enabled: true
  default_outgoing: telegram    # cli | telegram | feishu | http
  telegram:
    bot_token: YOUR_TELEGRAM_BOT_TOKEN
    chat_id: 'YOUR_TELEGRAM_CHAT_ID'
    proxy: ""                   # Optional, e.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080
                                # socks5 requires: pip install 'httpx[socks]'
  feishu:
    app_id: ""                  # Feishu/Lark App ID, e.g. cli_xxx
    app_secret: ""              # Feishu/Lark App Secret
    default_chat_id: ""         # Chat ID for scheduled/default outgoing messages, e.g. oc_xxx
    domain: https://open.feishu.cn  # Feishu: https://open.feishu.cn; Lark: https://open.larksuite.com
    transport: ws               # Built-in channel currently supports ws
    encrypt_key: ""             # Required for webhook/encrypted event subscriptions
    verification_token: ""      # Required for webhook event verification
    require_mention: true       # In groups, only respond when the bot is mentioned
    allow_chat_ids: []          # Optional allowlist of chat IDs
    allow_sender_ids: []        # Optional allowlist of sender open_id/user_id values
  http:
    enabled: true
    token: YOUR_WEBHOOK_TOKEN_RANDOM_STRING

# Database
database:
  path: secretary_v2.db

# Long-term memory markdown file and backups. Relative paths are resolved from
# the secretary_v2 directory, mirroring the default memory.md location.
memory:
  path: memory.md
  # When enabled, the app writes one snapshot per local date next to memory.path
  # before memory changes, e.g. memory-2026-06-29.md.
  backup_enabled: true
# Deterministic built-in maintenance policy.
maintenance:
  message_hide_after_days: 7
  event_archive_after_days: 7
  memory_warning_chars: 40000
  health_lookback_days: 7


# Skill loading
skills:
  max_size: 50000
  max_loaded: 5
  include_global: true
  paths: []
  auto_load: []
  triggers:
    smart-search:
      - search
      - query
      - opencli

# Search backend
search:
  backend: tavily
  tavily_api_key: YOUR_TAVILY_API_KEY

# Market calendar provider. Longbridge is queried in date windows and cached
# in memory. pandas_market_calendars is an unpinned dependency so exchange
# holiday rules can stay current; weekday fallback is last-resort degraded mode.
market_calendar:
  enabled: true
  provider: longbridge
  fallback_provider: pandas_market_calendars
  markets: [CN, HK, US]
  lookbehind_days: 3
  lookahead_days: 14
  cache_ttl_minutes: 720
  timeout_seconds: 10
  command: longbridge

# Background sub-agent sidecar
subagent:
  default_engine: claude
  # Used only when neither local Claude nor local Codex CLI is available.
  # Set to "" or disable subagent.agent.enabled to fail fast instead.
  fallback_engine: agent
  # Max background subagent runs allowed to start concurrently (across all
  # kinds). Enforced when the agent starts/resumes a run; default 1.
  max_concurrent: 1
  codex:
    model: ""
    max_concurrency: 1
    enable_search: true
    sandbox: read-only
    approval_policy: never
    config_overrides: []
  claude:
    model: sonnet
    effort: high
    max_concurrency: 1
    allowed_tools: [WebSearch, WebFetch, Read]
    allowed_bash: []
    disallowed_tools: []
  agent:
    enabled: true
    # Empty means reuse llm.model. Provider/api_key/base_url/max_tokens/effort/
    # thinking all come from llm, same as the main agent. This internal fallback
    # is isolated from message channels, scheduler, memory, and main-agent history.
    model: ""
    # Mirrors claude -p --allowedTools / --disallowedTools. The internal
    # fallback currently implements Bash(...) only; matching opencli entries
    # also inject smart-search and opencli-usage skill docs.
    allowed_tools:
      - "Bash(opencli list*)"
      - "Bash(opencli * -h)"
      - "Bash(opencli * --help)"
      - "Bash(opencli * * -h)"
      - "Bash(opencli * * --help)"
      - "Bash(opencli grok *)"
      - "Bash(opencli doubao *)"
      - "Bash(opencli gemini *)"
    disallowed_tools: []
    shell_timeout: 60
    system_prompt: >-
      You are a compact, isolated research subagent. Complete the assigned
      stage using only the prompt content and explicitly allowed tools. Do not
      claim access to local files, memory, reminders, message channels, or the
      main secretary agent state. Return only the stage output.

# History and compaction
history:
  context_tokens: 256000
  compress_threshold: 0.55
  tail_token_budget: 20000
  # HTTP webhook conversations replay only these recent local calendar days.
  # Older rows remain in SQLite; 0 disables the read-time retention window.
  webhook_retention_days: 5
  max_events: 10
  auto_compact: true
  compact_min_active_messages: 4
  compact_cooldown_minutes: 30
  compact_tool_output_max_chars: 4000

# Scheduled tasks use 5-field cron syntax in the configured timezone.
# handler defaults to agent and executes prompt through the secretary agent.
# Configuration-only built-ins use handler: builtin plus a code-registered task
# name; they cannot define prompt and are not exposed through schedule_task.
schedules:
  morning_briefing:
    cron: 0 8 * * *
    enabled: true
    prompt: |-
      Generate today's briefing for the Asia/Shanghai local day.
      1. Use db_query to inspect current open events.
      2. Query today's activity with:
         SELECT id,type,status,summary,content,created_at FROM events WHERE date(created_at,'+8 hours') = date('now','+8 hours') ORDER BY created_at ASC
      3. Combine those results with relevant content in memory.md.
      4. If anything important needs attention, call send_message with one concise, priority-ordered summary.
      5. Otherwise do not send a message. Always finish with NO_ACTION.
    protected: true
  morning_trend_scan:
    cron: 30 12 * * 1-5
    enabled: true
    prompt: |-
      At 12:30, remind the user to review the morning market trend.
      1. Call market_calendar for today and the configured markets; use it only for trading-day facts.
      2. Use db_query to inspect relevant open trade/opportunity events, then read positions and trading rules in memory.md.
      3. If relevant markets are closed, tailor the reminder to pending positions or rules instead of inventing a morning trend.
      4. Do not claim live prices or market moves unless they appear in fresh tool or event data.
      5. Call send_message with one concise reminder, then finish with NO_ACTION.
    protected: false
  pending_response_check:
    cron: 30 21 * * *
    enabled: true
    prompt: |-
      Check whether any scheduled proactive reminder still needs a user response.
      1. Use db_query:
         SELECT id,type,status,summary,content,created_at,source_channel FROM events WHERE status='open' AND type IN ('remind','check','triggered') AND source_channel='scheduled' ORDER BY created_at ASC
      2. For each candidate, inspect later events. If a response or user update closes the topic, update that event to status='resolved'.
      3. Group unresolved events by topic. Resolve every older duplicate and keep only the newest event open.
      4. If any unresolved topics remain, call send_message at most once with one merged follow-up.
      5. Do not create any event for this check. Always finish with NO_ACTION.
    protected: true
  review_reminder:
    cron: 0 19 * * *
    enabled: true
    prompt: |-
      Generate a review reminder for the Asia/Shanghai local day.
      1. Use db_query to inspect current open events and today's activity with:
         SELECT id,type,status,summary,content,created_at FROM events WHERE date(created_at,'+8 hours') = date('now','+8 hours') ORDER BY created_at ASC
      2. Combine those results with relevant content in memory.md.
      3. Call send_message with one concise review reminder, then finish with NO_ACTION.
    protected: false
  stale_check:
    cron: 0 9 * * 0
    enabled: true
    prompt: |-
      Review long-running topics that have not progressed.
      1. Use db_query to inspect current open events, then review memory.md and any relevant recent progress.
      2. Identify only topics that have genuinely had no progress for a long time.
      3. If any match, call send_message once to ask whether to continue, pause, or drop them.
      4. Otherwise do not send a message. Always finish with NO_ACTION.
      5. Do not create any event for this check, especially not a new status='open' event; existing open events remain the source of truth.
    protected: false
  memory_consolidation:
    cron: 0 4 * * 0
    enabled: true
    prompt: |-
      Weekly silent memory consolidation. Process one bounded batch; leave backlog for later runs.
      1. Call memory_view, then query candidate indexes without full bodies:
         SELECT id,type,source_channel,COALESCE(NULLIF(summary,''),substr(content,1,240)) AS summary,created_at FROM events WHERE context_visible=1 AND status='logged' AND type IN ('note','response') AND created_at >= datetime('now','-7 days') ORDER BY created_at DESC LIMIT 30
         SELECT id,type,source_channel,COALESCE(NULLIF(summary,''),substr(content,1,240)) AS summary,created_at FROM events WHERE context_visible=1 AND status='logged' AND type IN ('note','response') AND created_at < datetime('now','-7 days') ORDER BY created_at ASC LIMIT 20
      2. Select at most 12 exact IDs, prioritizing latest user statements, weekly rollups, and facts that update/conflict with memory over daily automated narration. Fetch only those full bodies with one id IN (...) query. Never inspect more than 12 full event bodies.
      3. Plan all writes before acting. Merge duplicate or overlapping bullets; keep current state, durable thesis/evidence, triggers, and next action; drop chronology. Preserve stable preferences, agreements, active plans, and decision reasons. Age alone is never evidence that an entry is obsolete. On conflict prefer the latest explicit user statement; if uncertain, keep existing text.
      4. Follow secretary-core memory.md rules. Make at most 6 successful edits and 8 attempts, using memory_str_replace for rewrites/deletions and memory_insert only for genuinely new durable knowledge. At/above the configured consolidation threshold, compact first and skip low-priority insertions.
      5. Call memory_view again to verify final text; re-read earlier only after an exact-match error. Never promote a source whose intended edit failed.
      6. After verification, update at most 12 reviewed IDs in at most two exact-ID batches. Use status='promoted' only when durable content is in memory.md. Use status='resolved' only when a later reviewed event supersedes it or it is clearly transient/duplicate with no durable or actionable value. Never update unseen or status='open' events.
      7. Never DELETE history or change context visibility; context_maintenance archives old resolved/promoted rows. Do not call send_message or create events. Stop at the limits and finish exactly NO_ACTION.
    protected: true
  context_maintenance:
    cron: 30 4 * * 0
    enabled: true
    handler: builtin
    task: context_maintenance
    protected: true
  system_review:
    cron: 30 17 * * 0
    enabled: true
    handler: builtin
    task: system_health_review
    protected: true

# Timezone
timezone: Asia/Shanghai
