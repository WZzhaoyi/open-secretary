[Unit]
Description=Delete stale Secretary v2 rotated logs (older than 14 days)

[Service]
Type=oneshot
User=@APP_USER@
# Covers both logrotate output (secretary_v2.log.1.gz ...) and the
# timestamped copies manage.sh made before systemd took over
# (secretary_v2.log.YYYYMMDD-HHMMSS).
ExecStart=/usr/bin/find @APP_DIR@/secretary_v2/logs -name 'secretary_v2.log.*' -type f -mtime +14 -delete
