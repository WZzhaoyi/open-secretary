# Rotate the live Secretary v2 log without restarting the service.
# copytruncate lets the running process keep its file descriptor: logrotate
# copies the file, then truncates the original in place. Combined with the
# systemd append: redirection this bounds the live file even if the service
# never restarts. Old rotations beyond "rotate 14" are removed by logrotate;
# the secretary-logclean.timer additionally sweeps any stray
# secretary_v2.log.* files older than 14 days.
@APP_DIR@/secretary_v2/logs/secretary_v2.log {
    daily
    maxsize 20M
    rotate 14
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
    su @APP_USER@ @APP_GROUP@
}
