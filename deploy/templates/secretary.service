[Unit]
Description=Secretary v2 agent (--channel all: Telegram + Feishu + HTTP)
Documentation=file:@APP_DIR@/README.md
After=network-online.target
Wants=network-online.target
# Not an infinite restart loop: more than 5 failed starts within 10 minutes
# puts the unit in the "failed" state and systemd stops retrying. Recover
# manually with: sudo systemctl reset-failed secretary && sudo systemctl start secretary
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@/secretary_v2
# The logs directory must exist BEFORE any Exec step runs: systemd opens the
# StandardOutput=append: target ahead of every Exec*, so an ExecStartPre=mkdir
# cannot create it (its own stdout redirect fails first). deploy.sh creates
# the directory at install time; recreate it manually after a bare re-clone.
# The runtime venv lives outside the source tree (uv-managed) so the checkout
# can be replaced/re-cloned without touching the environment, and vice versa.
ExecStart=@VENV_DIR@/bin/python main.py --channel all
Restart=on-failure
RestartSec=15
TimeoutStopSec=20

# HOME + PATH so shutil.which() finds subagent engine CLIs (claude/codex)
# under the user's home, and the CLIs can read their own auth/config there.
Environment=HOME=@APP_HOME@
Environment=PATH=@APP_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin

# Keep writing the same file manage.sh tails and failure alerts point at
# (secretary_v2/logs/secretary_v2.log). Rotation is handled by logrotate
# with copytruncate, so append mode here stays safe across rotations.
StandardOutput=append:@APP_DIR@/secretary_v2/logs/secretary_v2.log
StandardError=append:@APP_DIR@/secretary_v2/logs/secretary_v2.log

# Memory guardrails for a 2GB VPS. The cgroup includes subagent CLI children
# (claude/codex). Hitting MemoryMax kills the service, which counts as a
# failure toward the restart limit above.
MemoryHigh=1300M
MemoryMax=1600M

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
